<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Strata"
           Language="1033"
           Version="0.0.8"
           Manufacturer="Zsombor Simon"
           UpgradeCode="B5A3C4E5-6D7F-4A9B-8C1D-2E3F4A5B6C7D">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Strata is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="strata.ico" SourceFile="packaging/windows/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="strata.ico" />

    <UIRef Id="WixUI_Minimal" />

    <Feature Id="ProductFeature" Title="Strata" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Strata" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Strata" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="A1B2C3D4-E5F6-4A5B-8C9D-1E2F3A4B5C6D" Win64="yes">
        <File Id="StrataExe"
              Name="strata.exe"
              Source="dist/strata.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="LibStdCpp" Directory="INSTALLFOLDER" Guid="C1D2E3F4-A5B6-4C7D-8E9F-1A2B3C4D5E6F" Win64="yes">
        <File Id="LibStdCppDll"
              Name="libstdc++-6.dll"
              Source="dist/libstdc++-6.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="LibGcc" Directory="INSTALLFOLDER" Guid="D2E3F4A5-B6C7-4D8E-9F0A-2B3C4D5E6F7A" Win64="yes">
        <File Id="LibGccDll"
              Name="libgcc_s_seh-1.dll"
              Source="dist/libgcc_s_seh-1.dll"
              KeyPath="yes" />
      </Component>
      <Component Id="LibWinPthread" Directory="INSTALLFOLDER" Guid="E3F4A5B6-C7D8-4E9F-0A1B-3C4D5E6F7A8B" Win64="yes">
        <File Id="LibWinPthreadDll"
              Name="libwinpthread-1.dll"
              Source="dist/libwinpthread-1.dll"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="B2C3D4E5-F6A7-4B8C-9D0E-2F3A4B5C6D7E" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Strata"
                  Description="Native GPU-accelerated desktop database client"
                  Target="[INSTALLFOLDER]strata.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="strata.ico" />
        <Shortcut Id="ApplicationDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Strata"
                  Description="Native GPU-accelerated desktop database client"
                  Target="[INSTALLFOLDER]strata.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="strata.ico" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Strata" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
